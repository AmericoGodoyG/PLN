    "import spacy\n",
    "\n",
    "# python -m spacy download pt_core_news_lg (rodar no terminal - instala o modelo) \n",
    "nlp = spacy.load(\"pt_core_news_lg\")\n",
    "\n",
    "doc1 = nlp(\"Tiago é um professor\") \n",
    "doc2 = nlp(\"Tiago é um professor de PLN\")\n",
    "\n",
    "print(doc1.similarity(doc2))"
   ]
  }
